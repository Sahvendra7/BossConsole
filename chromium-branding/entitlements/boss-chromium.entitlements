<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT for Chromium JavaScript execution -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory for Chromium -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation for Chromium native libraries -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access for browser functionality -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow DYLD environment variables for Chromium -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Inherit entitlements from parent process -->
    <key>com.apple.security.inherit</key>
    <true/>

    <!-- WebAuthn/Passkey: Associated domains for platform authenticator -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:api.risaboss.com</string>
    </array>

    <!-- WebAuthn/Passkey: Keychain access for credential storage -->
    <key>com.apple.security.keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)ai.rever.boss.browser</string>
    </array>
</dict>
</plist>
